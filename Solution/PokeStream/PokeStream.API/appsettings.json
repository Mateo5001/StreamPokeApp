{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=tcp:<tu-servidor>.database.windows.net,1433;Initial Catalog=PokeStream;Persist Security Info=False;User ID=<tu-usuario>;Password=<tu-password>;MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;"
  },
  "Jwt": {
    "Key": "",
    "Issuer": "PokeStreamAPI",
    "Audience": "PokeStreamClient",
    "AccessTokenExpiryMinutes": 15,
    "RefreshTokenExpiryDays": 7
  }
}