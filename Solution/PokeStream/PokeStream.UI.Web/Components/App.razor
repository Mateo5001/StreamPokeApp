<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["PokeStream.UI.Web.styles.css"]" />
    <MudStyles />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet />
</head>

<body>
    <MudThemeProvider Theme="@PokestreamTheme.Default" />
    <Routes @rendermode="InteractiveServer" />
    <ReconnectModal />
    <MudSnackbar />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script>
        window.mudTheme = {
            setDarkMode: function (isDark) {
                document.documentElement.setAttribute('data-mud-theme', isDark ? 'dark' : 'light');
                localStorage.setItem('mudTheme', isDark ? 'dark' : 'light');
            },
            getDarkMode: function () {
                const saved = localStorage.getItem('mudTheme');
                if (saved) return saved === 'dark';
                return window.matchMedia('(prefers-color-scheme: dark)').matches;
            }
        };
        // Initialize theme on load
        document.documentElement.setAttribute('data-mud-theme', window.mudTheme.getDarkMode() ? 'dark' : 'light');
    </script>
</body>

</html>

@using PokeStream.UI.Web.Theme