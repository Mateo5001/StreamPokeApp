<div class="feature-card @(IsActive ? "feature-card--active" : "")"
     style="background: @Feature.Gradient; --feature-icon-color: @Feature.IconColor;"
     @onclick:preventDefault="true">
    <div class="feature-card__icon" style="color: @Feature.IconColor;">
        <AppIcon Name="@Feature.Icon" Size="32" />
    </div>
    <div class="feature-card__content">
        <h3 class="feature-card__title">@Feature.Title</h3>
        <p class="feature-card__description">@Feature.Description</p>
    </div>
    <div class="feature-card__glow"></div>
</div>

@code {
    [Parameter] public FeatureItem Feature { get; set; } = new();
    [Parameter] public int Index { get; set; }
    [Parameter] public bool IsActive { get; set; }
}