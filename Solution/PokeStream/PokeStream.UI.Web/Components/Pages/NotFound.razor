@page "/not-found"
@layout MainLayout
@inject NavigationManager Navigation

<PageTitle>Página no encontrada - PokéStream Collector</PageTitle>

<MudContainer Class="mt-12" MaxWidth="MaxWidth.Small">
    <MudCard Elevation="3" Class="pa-6 text-center">
        <MudCardContent>
            <AppIcon Name="search-off" Size="64" Class="mb-4" Style="color: var(--color-warning);" />
            <MudText Typo="Typo.h4" Class="mb-2" Style="font-weight: 700;">Página no encontrada</MudText>
            <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-6">
                Lo sentimos, la página que buscas no existe o ha sido movida.
            </MudText>

            <MudStack Row="true" Justify="Justify.Center" Spacing="3">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Href="/"
                           Type="ButtonType.Button">
                    <AppIcon Name="nav-home" Size="20" Class="me-1" Style="vertical-align: middle;" />
                    Volver al Inicio
                </MudButton>
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Primary"
                           Href="/login"
                           Type="ButtonType.Button">
                    <AppIcon Name="login" Size="20" Class="me-1" Style="vertical-align: middle;" />
                    Iniciar Sesión
                </MudButton>
            </MudStack>
        </MudCardContent>
    </MudCard>
</MudContainer>