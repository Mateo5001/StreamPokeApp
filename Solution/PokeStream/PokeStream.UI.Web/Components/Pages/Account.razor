@page "/account"
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Authorization
@using PokeStream.Core.DTOs.User
@using PokeStream.Core.Services.AuthServices
@using PokeStream.Resources.Account
@using PokeStream.Resources.Common
@using PokeStream.Resources.Creator
@using PokeStream.UI.Web.Components.Shared
@inject AuthStateService Auth

<PageTitle>@AccountResource.PageTitle</PageTitle>

<MudStack Spacing="4">

    @* User card *@
    <MudPaper Elevation="2" Class="pa-6">
        <MudStack Row="true" Spacing="4" AlignItems="AlignItems.Center">
            <MudAvatar Size="Size.Large" Color="Color.Primary" Style="width: 96px; height: 96px;">
                <MudIcon Icon="@AppIcon.Account" Style="font-size: 64px;" />
            </MudAvatar>
            <MudStack Spacing="0">
                <MudText Typo="Typo.h5">@_username</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">@_email</MudText>
            </MudStack>
        </MudStack>
    </MudPaper>

    @* Twitch: what was captured in chat belongs to the account linked here *@
    <MudPaper Elevation="2" Class="pa-6">
        <MudStack Spacing="3">
            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                <MudIcon Icon="@AppIcon.Twitch" Style="color: #9146FF;" />
                <MudText Typo="Typo.h6">@CreatorResource.TwitchTitle</MudText>
                <MudSpacer />
                @if (_twitchUsername is not null)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Success">@string.Format(CreatorResource.TwitchConnectedAs, _twitchUsername)</MudChip>
                }
            </MudStack>
            @if (_error is not null)
            {
                <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
            }
            else if (_loaded && _twitchUsername is null)
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary">@AccountResource.TwitchHint</MudText>
                <TwitchConnectButton />
            }
        </MudStack>
    </MudPaper>

    @* Main team *@
    <MudStack Spacing="1">
        <MudText Typo="Typo.h5">@AccountResource.TeamTitle</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">@AccountResource.TeamHint</MudText>
    </MudStack>

    <MudGrid Spacing="3">
        @for (var i = 0; i < TeamSize; i++)
        {
            var member = i < _team.Count ? _team[i] : null;
            <MudItem xs="6" sm="4" md="2">
                <MudCard Elevation="2" Class="mud-height-full">
                    <MudCardContent Class="d-flex flex-column align-center">
                        @if (member?.SpriteUrl is not null)
                        {
                            <img src="@member.SpriteUrl" alt="@member.Name" width="96" height="96" style="image-rendering: pixelated;" />
                        }
                        else
                        {
                            <MudAvatar Color="@(member is null ? Color.Default : Color.Primary)" Size="Size.Large">
                                <MudIcon Icon="@AppIcon.Pokeball" />
                            </MudAvatar>
                        }
                        @if (member is null)
                        {
                            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-2">@AccountResource.EmptySlot</MudText>
                        }
                        else
                        {
                            <MudText Typo="Typo.subtitle1" Class="mt-2">@member.Name</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@AccountResource.LevelPrefix @member.Level@(member.IsShiny ? " ✨" : "")</MudText>
                        }
                    </MudCardContent>
                </MudCard>
            </MudItem>
        }
    </MudGrid>
</MudStack>

@code {
    private const int TeamSize = 6;

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private string _username = string.Empty;
    private string _email = string.Empty;

    private IReadOnlyList<TeamMemberDto> _team = [];

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is null) return;
        var user = (await AuthState).User;
        _username = FirstClaim(user, "unique_name", "name", System.Security.Claims.ClaimTypes.Name);
        _email = FirstClaim(user, "email", System.Security.Claims.ClaimTypes.Email);
    }

    private string? _twitchUsername;
    private bool _loaded;
    private string? _error;

    // The session cookie is only writable once interactive, so the API is asked after the first render
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || AuthState is null || (await AuthState).User.Identity?.IsAuthenticated != true) return;

        try
        {
            _twitchUsername = (await Auth.GetCurrentUserAsync())?.TwitchUsername;
            _loaded = true;

            var response = await Auth.SendAuthorizedAsync(HttpMethod.Get, "api/v1/collection");
            if (response.IsSuccessStatusCode)
                _team = (await response.Content.ReadFromJsonAsync<CollectionDto>())!.Team;
            else
                _error = CommonResource.InternalServerError;
        }
        catch (HttpRequestException) { _error = CommonResource.ServerUnreachable; }
        StateHasChanged();
    }

    private static string FirstClaim(System.Security.Claims.ClaimsPrincipal user, params string[] types) =>
        types.Select(t => user.FindFirst(t)?.Value).FirstOrDefault(v => !string.IsNullOrEmpty(v)) ?? string.Empty;
}
