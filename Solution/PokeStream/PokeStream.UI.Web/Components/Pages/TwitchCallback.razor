@page "/twitch/callback"
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Authorization
@using PokeStream.Core.DTOs.Twitch
@using PokeStream.Core.Services.AuthServices
@using PokeStream.Resources.Common
@using PokeStream.Resources.Creator
@using PokeStream.UI.Web.Components.Shared
@inject AuthStateService Auth
@inject NavigationManager Navigation

<PageTitle>@CreatorResource.TwitchTitle</PageTitle>

<MudStack Spacing="3">
    <MudText Typo="Typo.h5">@CreatorResource.TwitchTitle</MudText>
    @if (_error is null)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else
    {
        <MudAlert Severity="Severity.Error">@_error</MudAlert>
        <MudButton Variant="Variant.Outlined" Href="/account" Style="align-self: flex-start;">@CreatorResource.TwitchBackToAccount</MudButton>
    }
</MudStack>

@code {
    // Appended by Twitch when it redirects back here
    [SupplyParameterFromQuery(Name = "code")] public string? Code { get; set; }
    [SupplyParameterFromQuery(Name = "state")] public string? State { get; set; }
    [SupplyParameterFromQuery(Name = "error")] public string? TwitchError { get; set; }

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private string? _error;

    // After render, never during prerender: the authorization code works only once.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || AuthState is null) return;
        var user = (await AuthState).User;
        if (user.Identity?.IsAuthenticated != true) return;

        if (TwitchError is not null)
        {
            _error = CreatorResource.TwitchCancelled;
        }
        else if (Code is null || State is null)
        {
            _error = CreatorResource.TwitchLinkExpired;
        }
        else
        {
            try
            {
                var response = await Auth.SendAuthorizedAsync(HttpMethod.Post, "api/v1/twitch/link",
                    JsonContent.Create(new TwitchLinkRequest(Code, State)));
                if (response.IsSuccessStatusCode)
                {
                    Navigation.NavigateTo(user.IsInRole("Streamer") ? "/creator" : "/account", replace: true);
                    return;
                }
                _error = await TwitchConnectButton.ReadErrorAsync(response);
            }
            catch (HttpRequestException) { _error = CommonResource.ServerUnreachable; }
        }
        StateHasChanged();
    }
}
