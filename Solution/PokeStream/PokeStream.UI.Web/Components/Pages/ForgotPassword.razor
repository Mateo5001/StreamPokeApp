@page "/forgot-password"
@inject NavigationManager Navigation

<PageTitle>Recuperar Contraseña - PokéStream Collector</PageTitle>

<MudContainer Class="mt-12" MaxWidth="MaxWidth.Small">
    <MudCard Elevation="3" Class="pa-6">
        <MudCardContent>
            <!-- Hero icon -->
            <div class="text-center mb-4">
                <AppIcon Name="pokeball" Size="56" Style="color: var(--color-primary);" />
            </div>

            <MudText Typo="Typo.h4" Class="mb-1 text-center" Style="font-weight: 700;">Recuperar Contraseña</MudText>
            <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-6 text-center">
                Ingresa tu email para recibir instrucciones de recuperación
            </MudText>

            <MudAlert Severity="Severity.Success" Class="mb-4" Visible="@EmailSent">
                <AppIcon Name="check-circle" Size="20" Class="me-2" Style="color: var(--color-tertiary); vertical-align: middle;" />
                Si el email existe en nuestro sistema, recibirás instrucciones para restablecer tu contraseña.
            </MudAlert>

            <MudAlert Severity="Severity.Error" Class="mb-4" Visible="@(!string.IsNullOrEmpty(ErrorMessage) && !EmailSent)">
                @ErrorMessage
            </MudAlert>

            <MudForm @ref="Form" Method="OnSubmitAsync" Disabled="@(EmailSent)">
                <MudTextField @bind-Value="Model.Email"
                              Label="Email"
                              Type="InputType.Email"
                              Required
                              RequiredError="El email es obligatorio"
                              FullWidth="true"
                              Class="mb-4"
                              Adornment="Adornment.Start">
                    <Adornment>
                        <AppIcon Name="email" Size="20" Style="color: var(--color-on-surface-variant);" />
                    </Adornment>
                </MudTextField>

                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Type="ButtonType.Submit"
                           FullWidth="true"
                           Size="Size.Large"
                           Disabled="@(IsSubmitting || EmailSent)">
                    @(IsSubmitting ? "Enviando..." : EmailSent ? "Email Enviado" : "Enviar Instrucciones")
                </MudButton>
            </MudForm>

            <MudDivider Class="my-4" />

            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="text-center">
                ¿Recordaste tu contraseña?
                <MudButton Variant="Variant.Text"
                           Color="Color.Primary"
                           Size="Size.Small"
                           Href="/login">
                    Volver al Login
                </MudButton>
            </MudText>
        </MudCardContent>
    </MudCard>

    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="text-center mt-3 d-block">
        <AppIcon Name="info" Size="16" Class="me-1" Style="color: var(--color-info); vertical-align: middle;" />
        Funcionalidad de recuperación de contraseña pendiente de implementar en el backend
    </MudText>
</MudContainer>

@code {
    private MudForm? Form;
    private bool IsSubmitting = false;
    private bool EmailSent = false;
    private string ErrorMessage = string.Empty;

    private ForgotPasswordRequest Model = new();

    private async Task OnSubmitAsync()
    {
        await Form!.ValidateAsync();

        if (!Form.IsValid)
            return;

        IsSubmitting = true;
        ErrorMessage = string.Empty;

        try
        {
            // TODO: Implementar llamada al backend para enviar email de recuperación
            // await AuthState.ForgotPasswordAsync(Model.Email);

            // Simular envío
            await Task.Delay(1000);
            EmailSent = true;
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            IsSubmitting = false;
        }
    }

    private class ForgotPasswordRequest
    {
        public string Email { get; set; } = string.Empty;
    }
}