@page "/"
@inject NavigationManager Navigation
@inject AuthStateService AuthState
@inject IJSRuntime JS
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@rendermode InteractiveServer

<PageTitle>PokéStream Collector</PageTitle>

<div class="home-page">
    <!-- Hero Section -->
    <section class="home-page__hero" aria-labelledby="hero-title">
        <div class="home-page__hero-content">
            <div class="home-page__logo" aria-hidden="true">
                <AppIcon Name="pokeball" Size="48" Style="color: var(--color-on-primary);" />
            </div>
            <h1 id="hero-title" class="home-page__title">PokéStream Collector</h1>
            <p class="home-page__subtitle">
                Captura, colecciona e intercambia Pokémon en vivo durante los streams.
                Tu Pokédex persistente, multiplataforma y siempre contigo.
            </p>

            <AuthorizeView>
                <Authorized>
                    <div class="home-page__cta-group">
                        <button class="btn btn--primary btn--large" @onclick="GoToCollection">
                            <AppIcon Name="pokeball" Size="20" Class="me-1" Style="vertical-align: middle;" />
                            Ver mi Colección
                        </button>
                        <button class="btn btn--outline btn--large" @onclick="GoToLeaderboard">
                            <AppIcon Name="trophy" Size="20" Class="me-1" Style="vertical-align: middle;" />
                            Ver Ranking
                        </button>
                    </div>
                </Authorized>
                <NotAuthorized>
                    <div class="home-page__cta-group">
                        <button class="btn btn--primary btn--large" @onclick="GoToLogin">
                            <AppIcon Name="login" Size="20" Class="me-1" Style="vertical-align: middle;" />
                            Iniciar Sesión
                        </button>
                        <button class="btn btn--outline btn--large" @onclick="GoToRegister">
                            <AppIcon Name="person-add" Size="20" Class="me-1" Style="vertical-align: middle;" />
                            Registrarse
                        </button>
                    </div>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </section>

    <!-- Features Carousel Section -->
    <section class="home-page__features-section" aria-labelledby="features-title">
        <header class="home-page__section-header">
            <h2 id="features-title" class="home-page__section-title">Todo lo que necesitas</h2>
            <p class="home-page__section-subtitle">
                Diseñado para streamers y viewers. Capturas en vivo, colección unificada,
                intercambios sociales y verificación automática.
            </p>
        </header>

        <FeatureCarousel />
    </section>

    <!-- How It Works Section -->
    <section class="home-page__how-it-works" aria-labelledby="how-title">
        <header class="home-page__section-header">
            <h2 id="how-title" class="home-page__section-title">¿Cómo funciona?</h2>
            <p class="home-page__section-subtitle">
                Dos experiencias, una sola plataforma. Elige tu rol y empieza a jugar.
            </p>
        </header>

        <div class="home-page__how-card">
            <article class="home-page__how-item">
                <div class="home-page__how-icon">
                    <AppIcon Name="stream" Size="24" />
                </div>
                <h3 class="home-page__how-title">Para Streamers</h3>
                <p class="home-page__how-description">
                    Ejecuta la app de overlay (MAUI), conéctala a OBS o Streamlabs
                    y muestra Pokémon aleatorios en tu stream con un solo clic.
                </p>
            </article>

            <article class="home-page__how-item">
                <div class="home-page__how-icon">
                    <AppIcon Name="chat" Size="24" />
                </div>
                <h3 class="home-page__how-title">Para Viewers</h3>
                <p class="home-page__how-description">
                    Escribe <code class="text-code-inline">!catch</code> en el chat para capturar
                    el Pokémon mostrado. Gestiona tu colección completa en la web app.
                </p>
            </article>
        </div>
    </section>

    <!-- Footer -->
    <footer class="home-page__footer" role="contentinfo">
        <p class="home-page__footer-text">
            PokéStream Collector &mdash; Hecho con ❤️ para la comunidad de Pokémon y streamers
        </p>
        <nav class="home-page__footer-links" aria-label="Enlaces legales">
            <a href="/privacy" class="home-page__footer-link">Privacidad</a>
            <a href="/terms" class="home-page__footer-link">Términos</a>
            <a href="/contact" class="home-page__footer-link">Contacto</a>
            <a href="https://github.com/Mateo5001/StreamPokeApp" class="home-page__footer-link" target="_blank" rel="noopener">GitHub</a>
        </nav>
    </footer>
</div>

@code {
    private bool _isAuthenticated = false;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthState.GetAuthenticationStateAsync();
        _isAuthenticated = authState.User?.Identity?.IsAuthenticated ?? false;
    }

    private async Task GoToLogin()
    {
        Console.WriteLine("GoToLogin clicked - server method executing");
        Navigation.NavigateTo("/login", forceLoad: true);
    }

    private async Task GoToRegister()
    {
        Console.WriteLine("GoToRegister clicked - server method executing");
        Navigation.NavigateTo("/register", forceLoad: true);
    }

    private async Task GoToCollection()
    {
        Console.WriteLine("GoToCollection clicked - server method executing");
        Navigation.NavigateTo("/collection", forceLoad: true);
    }

    private async Task GoToLeaderboard()
    {
        Console.WriteLine("GoToLeaderboard clicked - server method executing");
        Navigation.NavigateTo("/leaderboard", forceLoad: true);
    }
}