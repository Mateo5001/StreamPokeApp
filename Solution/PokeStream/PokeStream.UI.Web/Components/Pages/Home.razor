@page "/"
@inject NavigationManager Navigation
@inject AuthStateService AuthState

<PageTitle>PokéStream Collector</PageTitle>

<MudContainer Class="mt-12" MaxWidth="MaxWidth.Medium">
    <MudGrid Justify="Justify.Center" AlignItems="AlignItems.Center" Class="min-vh-50">
        <MudItem xs="12" md="10" lg="8">
            <!-- Hero Section -->
            <MudCard Elevation="3" Class="pa-6 text-center">
                <MudCardContent>
                    <MudIcon Icon="@Icons.Material.Filled.CatchingPokemon" Size="Size.Large" Color="Color.Primary" Class="mb-4" />
                    <MudText Typo="Typo.h3" Class="mb-2" Style="font-weight: 700;">PokéStream Collector</MudText>
                    <MudText Typo="Typo.h6" Color="Color.Secondary" Class="mb-6">
                        Captura, colecciona e intercambia Pokémon en vivo durante los streams
                    </MudText>

                    <AuthorizeView>
                        <Authorized>
                            <MudStack Row="true" Justify="Justify.Center" Spacing="3" Class="mt-4">
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" Href="/collection" StartIcon="@Icons.Material.Filled.CatchingPokemon">
                                    Ver mi Colección
                                </MudButton>
                                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Large" Href="/leaderboard" StartIcon="@Icons.Material.Filled.Leaderboard">
                                    Ver Ranking
                                </MudButton>
                            </MudStack>
                        </Authorized>
                        <NotAuthorized>
                            <MudStack Row="true" Justify="Justify.Center" Spacing="3" Class="mt-4">
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" OnClick="@(() => Navigation.NavigateTo("/login"))" StartIcon="@Icons.Material.Filled.Login">
                                    Iniciar Sesión
                                </MudButton>
                                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Large" OnClick="@(() => Navigation.NavigateTo("/register"))" StartIcon="@Icons.Material.Filled.PersonAdd">
                                    Registrarse
                                </MudButton>
                            </MudStack>
                        </NotAuthorized>
                    </AuthorizeView>
                </MudCardContent>
            </MudCard>

            <!-- Features Section -->
            <MudGrid Class="mt-8" Justify="Justify.Center">
                <MudItem xs="12" md="4">
                    <MudCard Variant="Variant.Outlined" Class="pa-4 text-center h-100">
                        <MudCardContent>
                            <MudIcon Icon="@Icons.Material.Filled.LiveTv" Size="Size.Large" Color="Color.Secondary" Class="mb-3" />
                            <MudText Typo="Typo.h6" Class="mb-2">Captura en Vivo</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                Los streamers muestran Pokémon en su overlay; los viewers capturan con comandos de chat
                            </MudText>
                        </MudCardContent>
                    </MudCard>
                </MudItem>

                <MudItem xs="12" md="4">
                    <MudCard Variant="Variant.Outlined" Class="pa-4 text-center h-100">
                        <MudCardContent>
                            <MudIcon Icon="@Icons.Material.Filled.CollectionsBookmark" Size="Size.Large" Color="Color.Secondary" Class="mb-3" />
                            <MudText Typo="Typo.h6" Class="mb-2">Tu Pokédex</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                Colección persistente multiplataforma (Twitch, YouTube, Kick) con historial completo
                            </MudText>
                        </MudCardContent>
                    </MudCard>
                </MudItem>

                <MudItem xs="12" md="4">
                    <MudCard Variant="Variant.Outlined" Class="pa-4 text-center h-100">
                        <MudCardContent>
                            <MudIcon Icon="@Icons.Material.Filled.SwapHoriz" Size="Size.Large" Color="Color.Secondary" Class="mb-3" />
                            <MudText Typo="Typo.h6" Class="mb-2">Intercambios</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                Intercambia Pokémon con otros viewers, completa tu Pokédex y sube en el ranking
                            </MudText>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
            </MudGrid>

            <!-- How it works -->
            <MudCard Variant="Variant.Outlined" Class="mt-8 pa-4">
                <MudCardContent>
                    <MudText Typo="Typo.h6" Class="mb-4 text-center">¿Cómo funciona?</MudText>
                    <MudGrid>
                        <MudItem xs="12" md="6">
                            <MudText Typo="Typo.subtitle1" Class="mb-1"><MudIcon Icon="@Icons.Material.Filled.Stream" Size="Size.Small" Class="me-1" Color="Color.Primary" /> Para Streamers</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                Ejecuta la app de overlay (MAUI), conéctala a OBS/Streamlabs y muestra Pokémon aleatorios en tu stream
                            </MudText>
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudText Typo="Typo.subtitle1" Class="mb-1"><MudIcon Icon="@Icons.Material.Filled.Chat" Size="Size.Small" Class="me-1" Color="Color.Primary" /> Para Viewers</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                Escribe <code>!catch</code> en el chat para capturar el Pokémon mostrado. ¡Gestiona tu colección en la web!
                            </MudText>
                        </MudItem>
                    </MudGrid>
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>
</MudContainer>