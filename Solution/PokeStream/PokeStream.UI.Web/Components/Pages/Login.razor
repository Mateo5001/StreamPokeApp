@page "/login"
@inject NavigationManager Navigation
@inject AuthStateService AuthState

<PageTitle>Iniciar Sesión - PokéStream Collector</PageTitle>

<MudContainer Class="mt-12" MaxWidth="MaxWidth.Small">
    <MudCard Elevation="3" Class="pa-6">
        <MudCardContent>
            <!-- Hero icon -->
            <div class="text-center mb-4">
                <AppIcon Name="pokeball" Size="56" Style="color: var(--color-primary);" />
            </div>

            <MudText Typo="Typo.h4" Class="mb-1 text-center" Style="font-weight: 700;">Iniciar Sesión</MudText>
            <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-6 text-center">
                Accede a tu Pokédex y captura Pokémon en vivo
            </MudText>

            <MudAlert Severity="Severity.Error" Class="mb-4" Visible="@(!string.IsNullOrEmpty(ErrorMessage))">
                @ErrorMessage
            </MudAlert>

            <MudForm @ref="Form" Method="OnSubmitAsync">
                <MudTextField @bind-Value="Model.UsernameOrEmail"
                              Label="Usuario o Email"
                              Required
                              RequiredError="El usuario o email es obligatorio"
                              FullWidth="true"
                              Class="mb-4"
                              Adornment="Adornment.Start">
                    <Adornment>
                        <AppIcon Name="nav-profile" Size="20" Style="color: var(--color-on-surface-variant);" />
                    </Adornment>
                </MudTextField>

                <MudTextField @bind-Value="Model.Password"
                              Label="Contraseña"
                              InputType="InputType.Password"
                              Required
                              RequiredError="La contraseña es obligatoria"
                              FullWidth="true"
                              Class="mb-4"
                              Adornment="Adornment.Start">
                    <Adornment>
                        <AppIcon Name="nav-settings" Size="20" Style="color: var(--color-on-surface-variant);" />
                    </Adornment>
                </MudTextField>

                <MudCheckBox @bind-Value="Model.DeviceInfo"
                             Label="Recordarme"
                             Class="mb-4"
                             Color="Color.Primary" />

                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Type="ButtonType.Submit"
                           FullWidth="true"
                           Size="Size.Large"
                           Disabled="@IsSubmitting"
                           Class="mb-3">
                    @(IsSubmitting ? "Iniciando sesión..." : "Iniciar Sesión")
                </MudButton>
            </MudForm>

            <MudDivider Class="my-4" />

            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="text-center mb-3">
                ¿No tienes cuenta?
                <MudButton Variant="Variant.Text"
                           Color="Color.Primary"
                           Size="Size.Small"
                           Href="/register">
                    Regístrate aquí
                </MudButton>
            </MudText>

            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="text-center d-block">
                <MudButton Variant="Variant.Text"
                           Color="Color.Secondary"
                           Size="Size.Small"
                           Href="/forgot-password">
                    ¿Olvidaste tu contraseña?
                </MudButton>
            </MudText>
        </MudCardContent>
    </MudCard>

    <!-- Demo credentials hint -->
    <MudCard Variant="Variant.Outlined" Class="mt-4 pa-4" Style="background-color: var(--color-info); opacity: 0.1; border-color: var(--color-info);">
        <MudCardContent>
            <MudText Typo="Typo.caption" Color="Color.Info" Class="text-center">
                <AppIcon Name="pokeball" Size="16" Class="me-1" Style="color: var(--color-info); vertical-align: middle;" />
                Demo: usa cualquier usuario/contraseña (se registrará automáticamente si no existe)
            </MudText>
        </MudCardContent>
    </MudCard>
</MudContainer>

@code {
    private MudForm? Form;
    private bool IsSubmitting = false;
    private string ErrorMessage = string.Empty;

    private LoginRequest Model = new();

    private async Task OnSubmitAsync()
    {
        await Form!.ValidateAsync();

        if (!Form.IsValid)
            return;

        IsSubmitting = true;
        ErrorMessage = string.Empty;

        try
        {
            var response = await AuthState.LoginAsync(Model);

            if (response != null)
            {
                // Redirect to home or return URL
                var uri = new Uri(Navigation.Uri);
                var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
                var redirectUrl = query["returnUrl"] ?? "/";

                Navigation.NavigateTo(redirectUrl, forceLoad: true);
            }
            else
            {
                ErrorMessage = "Credenciales inválidas. Verifica tu usuario/email y contraseña.";
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Error al iniciar sesión: {ex.Message}";
        }
        finally
        {
            IsSubmitting = false;
        }
    }
}