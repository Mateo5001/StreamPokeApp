@page "/login"
@using PokeStream.Core.DTOs.Auth
@using PokeStream.Core.Services.AuthServices
@using PokeStream.Core.Services.Cookies
@using PokeStream.Resources.Auth
@inject LoginService Logins
@inject ICookieService Cookies
@inject NavigationManager Navigation

<PageTitle>@LoginResource.Title</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraSmall" Class="py-8">
    <MudPaper Elevation="4" Class="pa-6 pa-sm-8">
        <MudStack Spacing="4">

            <MudText Typo="Typo.h4" Align="Align.Center">@LoginResource.Title</MudText>

            <MudForm @ref="_form" Model="@_request">
                <EditForm Model="@_request" OnSubmit="LoginAsync">
                    <DataAnnotationsValidator />
                    <MudStack Spacing="1">
                        <MudTextField @bind-Value="_request.UsernameOrEmail"
                                      For="@(() => _request.UsernameOrEmail)"
                                      Label="@LoginResource.UsernameOrEmail"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      AutoFocus="true" />

                        <MudTextField @bind-Value="_request.Password"
                                      For="@(() => _request.Password)"
                                      Label="@LoginResource.Password"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      InputType="@(_showPassword ? InputType.Text : InputType.Password)"
                                      Adornment="Adornment.End"
                                      AdornmentIcon="@(_showPassword ? AppIcon.VisibilityOff : AppIcon.Visibility)"
                                      OnAdornmentClick="() => _showPassword = !_showPassword"
                                      AdornmentAriaLabel="@LoginResource.ShowHidePassword" />

                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                            <MudCheckBox @bind-Value="_remember" Label="@LoginResource.RememberMe" Dense="true" Color="Color.Primary" />
                            <MudLink Href="/forgot-password" Typo="Typo.caption">@LoginResource.ForgotPassword</MudLink>
                        </MudStack>
                    </MudStack>
                </EditForm>
            </MudForm>

            @if (_error is not null)
            {
                <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
            }

            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" FullWidth="true"
                       Disabled="_busy" OnClick="LoginAsync">
                @if (_busy)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-2" />
                }
                @LoginResource.SubmitButton
            </MudButton>

            <MudDivider />
            <MudText Typo="Typo.caption" Align="Align.Center">@LoginResource.OrContinueWith</MudText>

            <MudStack Spacing="1">
                <MudButton Variant="Variant.Filled" FullWidth="true" StartIcon="@AppIcon.Twitch"
                           Style="background-color: #9146FF; color: #FFFFFF;">Twitch</MudButton>
                <MudButton Variant="Variant.Filled" FullWidth="true" StartIcon="@AppIcon.Kick"
                           Style="background-color: #53FC18; color: #000000;">Kick</MudButton>
                <MudButton Variant="Variant.Filled" FullWidth="true" StartIcon="@AppIcon.YouTube"
                           Style="background-color: #FF0000; color: #FFFFFF;">YouTube</MudButton>
            </MudStack>

            <MudText Typo="Typo.body2" Align="Align.Center">
                @LoginResource.NoAccount
                <MudLink Href="/register">@LoginResource.CreateAccount</MudLink>
            </MudText>

        </MudStack>
    </MudPaper>
</MudContainer>

@code {
    private MudForm? _form;
    private readonly LoginRequest _request = new();
    private bool _remember; // UI only: persisted as a cookie, not part of LoginRequest

    private bool _showPassword;
    private bool _busy;
    private string? _error;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        // Pre-fill the remembered username (JS cookies are only available after the first render)
        var user = await Cookies.GetAsync(CookieKeys.RememberedUser);
        if (string.IsNullOrEmpty(user)) return;

        _request.UsernameOrEmail = user;
        _remember = true;
        StateHasChanged();
    }

    private async Task LoginAsync()
    {
        if (_form is null || _busy) return;
        await _form.ValidateAsync();
        if (!_form.IsValid) return;

        _busy = true;
        _error = null;
        try
        {
            _error = await Logins.LoginAsync(_request, _remember);

            if (_error is null)
                Navigation.NavigateTo("/account");
        }
        finally
        {
            _busy = false;
        }
    }
}
