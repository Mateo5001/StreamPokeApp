@page "/register"
@using PokeStream.Core.DTOs.Auth
@using PokeStream.Core.Services.AuthServices
@using PokeStream.Resources.Auth
@using PokeStream.Resources.Common
@inject AuthStateService Auth
@inject NavigationManager Navigation

<PageTitle>@RegisterResource.Title</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="py-8">
    <MudPaper Elevation="4" Class="pa-6 pa-sm-8">
        <MudStack Spacing="4">

            <MudStack Spacing="1" AlignItems="AlignItems.Center">
                <MudText Typo="Typo.h4" Align="Align.Center">@RegisterResource.Title</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center">@RegisterResource.Subtitle</MudText>
            </MudStack>

            <MudForm @ref="_form" Model="@_request">
                <EditForm Model="@_request">
                    <DataAnnotationsValidator />
                    <MudStack Spacing="1">

                        <MudTextField @bind-Value="_request.Username"
                                      For="@(() => _request.Username)"
                                      Label="@RegisterResource.Username"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      AutoFocus="true"
                                      Immediate="true" />

                        <MudTextField @bind-Value="_request.Email"
                                      For="@(() => _request.Email)"
                                      Label="@RegisterResource.Email"
                                      InputType="InputType.Email"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Immediate="true" />

                        <MudTextField @bind-Value="_request.DisplayName"
                                      For="@(() => _request.DisplayName)"
                                      Label="@RegisterResource.DisplayName"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense" />

                        <MudGrid Spacing="2">
                            <MudItem xs="12" sm="6">
                                <MudTextField @bind-Value="_request.Password"
                                              For="@(() => _request.Password)"
                                              Label="@RegisterResource.Password"
                                              Variant="Variant.Outlined"
                                              Margin="Margin.Dense"
                                              Immediate="true"
                                              InputType="@(_showPassword ? InputType.Text : InputType.Password)"
                                              Adornment="Adornment.End"
                                              AdornmentIcon="@(_showPassword ? AppIcon.VisibilityOff : AppIcon.Visibility)"
                                              OnAdornmentClick="() => _showPassword = !_showPassword"
                                              AdornmentAriaLabel="@RegisterResource.ShowHidePassword" />
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudTextField @bind-Value="_confirmPassword"
                                              Label="@RegisterResource.ConfirmPassword"
                                              Variant="Variant.Outlined"
                                              Margin="Margin.Dense"
                                              Immediate="true"
                                              InputType="@(_showPassword ? InputType.Text : InputType.Password)"
                                              Validation="@((string? value) => value == _request.Password ? null : RegisterResource.PasswordsDoNotMatch)" />
                            </MudItem>
                        </MudGrid>
                    </MudStack>
                </EditForm>
            </MudForm>

            @if (_error is not null)
            {
                <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
            }

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Size="Size.Large"
                       FullWidth="true"
                       Disabled="_busy"
                       OnClick="RegisterAsync">
                @if (_busy)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-2" />
                }
                @RegisterResource.SubmitButton
            </MudButton>

            <MudText Typo="Typo.body2" Align="Align.Center">
                @RegisterResource.HaveAccount
                <MudLink Href="/login">@RegisterResource.SignIn</MudLink>
            </MudText>

        </MudStack>
    </MudPaper>
</MudContainer>

@code {
    private MudForm? _form;
    private readonly RegisterRequest _request = new();
    private string _confirmPassword = string.Empty; // UI only: RegisterRequest has no confirm field

    private bool _showPassword;
    private bool _busy;
    private string? _error;

    private async Task RegisterAsync()
    {
        if (_form is null) return;
        await _form.ValidateAsync();
        if (!_form.IsValid) return;

        _busy = true;
        _error = null;
        try
        {
            // Optional fields: send null instead of empty strings
            _request.DisplayName = NullIfEmpty(_request.DisplayName);

            var response = await Auth.RegisterAsync(_request);
            if (response is null)
            {
                _error = RegisterResource.RegisterFailed;
                return;
            }

            Navigation.NavigateTo("/account");
        }
        catch (HttpRequestException)
        {
            _error = CommonResource.ServerUnreachable;
        }
        finally
        {
            _busy = false;
        }
    }

    private static string? NullIfEmpty(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();
}
