@page "/register"
@inject NavigationManager Navigation
@inject AuthStateService AuthState

<PageTitle>Registrarse - PokéStream Collector</PageTitle>

<MudContainer Class="mt-12" MaxWidth="MaxWidth.Small">
    <MudCard Elevation="3" Class="pa-6">
        <MudCardContent>
            <!-- Hero icon -->
            <div class="text-center mb-4">
                <AppIcon Name="pokeball" Size="56" Style="color: var(--color-primary);" />
            </div>

            <MudText Typo="Typo.h4" Class="mb-1 text-center" Style="font-weight: 700;">Crear Cuenta</MudText>
            <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-6 text-center">
                Únete a PokéStream Collector y empieza tu Pokédex
            </MudText>

            <MudAlert Severity="Severity.Error" Class="mb-4" Visible="@(!string.IsNullOrEmpty(ErrorMessage))">
                @ErrorMessage
            </MudAlert>

            <MudForm @ref="Form" Method="OnSubmitAsync">
                <MudTextField @bind-Value="Model.Username"
                              Label="Nombre de Usuario"
                              Required
                              RequiredError="El nombre de usuario es obligatorio"
                              MinLength="3"
                              MaxLength="30"
                              Pattern="^[a-zA-Z0-9_]+$"
                              PatternError="Solo letras, números y guión bajo"
                              FullWidth="true"
                              Class="mb-4"
                              Adornment="Adornment.Start">
                    <Adornment>
                        <AppIcon Name="nav-profile" Size="20" Style="color: var(--color-on-surface-variant);" />
                    </Adornment>
                </MudTextField>

                <MudTextField @bind-Value="Model.Email"
                              Label="Email"
                              Type="InputType.Email"
                              Required
                              RequiredError="El email es obligatorio"
                              FullWidth="true"
                              Class="mb-4"
                              Adornment="Adornment.Start">
                    <Adornment>
                        <AppIcon Name="chat" Size="20" Style="color: var(--color-on-surface-variant);" />
                    </Adornment>
                </MudTextField>

                <MudTextField @bind-Value="Model.DisplayName"
                              Label="Nombre para Mostrar (opcional)"
                              MaxLength="50"
                              FullWidth="true"
                              Class="mb-4"
                              Adornment="Adornment.Start">
                    <Adornment>
                        <AppIcon Name="nav-profile" Size="20" Style="color: var(--color-on-surface-variant);" />
                    </Adornment>
                </MudTextField>

                <MudTextField @bind-Value="Model.Password"
                              Label="Contraseña"
                              InputType="InputType.Password"
                              Required
                              RequiredError="La contraseña es obligatoria"
                              MinLength="8"
                              MinLengthError="Mínimo 8 caracteres"
                              FullWidth="true"
                              Class="mb-4"
                              Adornment="Adornment.Start"
                              HelperText="Mínimo 8 caracteres">
                    <Adornment>
                        <AppIcon Name="nav-settings" Size="20" Style="color: var(--color-on-surface-variant);" />
                    </Adornment>
                </MudTextField>

                <MudTextField @bind-Value="ConfirmPassword"
                              Label="Confirmar Contraseña"
                              InputType="InputType.Password"
                              Required
                              RequiredError="Confirma tu contraseña"
                              FullWidth="true"
                              Class="mb-4"
                              Adornment="Adornment.Start">
                    <Adornment>
                        <AppIcon Name="nav-settings" Size="20" Style="color: var(--color-on-surface-variant);" />
                    </Adornment>
                </MudTextField>

                <MudCheckBox @bind-Value="AcceptTerms"
                             Label="Acepto los términos y condiciones"
                             Required
                             RequiredError="Debes aceptar los términos"
                             Color="Color.Primary"
                             Class="mb-4" />

                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Type="ButtonType.Submit"
                           FullWidth="true"
                           Size="Size.Large"
                           Disabled="@IsSubmitting">
                    @(IsSubmitting ? "Registrando..." : "Crear Cuenta")
                </MudButton>
            </MudForm>

            <MudDivider Class="my-4" />

            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="text-center">
                ¿Ya tienes cuenta?
                <MudButton Variant="Variant.Text"
                           Color="Color.Primary"
                           Size="Size.Small"
                           Href="/login">
                    Inicia sesión
                </MudButton>
            </MudText>
        </MudCardContent>
    </MudCard>
</MudContainer>

@code {
    private MudForm? Form;
    private bool IsSubmitting = false;
    private string ErrorMessage = string.Empty;

    private RegisterRequest Model = new();
    private string ConfirmPassword = string.Empty;
    private bool AcceptTerms = false;

    private async Task OnSubmitAsync()
    {
        await Form!.ValidateAsync();

        if (!Form.IsValid)
            return;

        if (Model.Password != ConfirmPassword)
        {
            ErrorMessage = "Las contraseñas no coinciden";
            return;
        }

        IsSubmitting = true;
        ErrorMessage = string.Empty;

        try
        {
            var response = await AuthState.RegisterAsync(Model);

            if (response != null)
            {
                Navigation.NavigateTo("/", forceLoad: true);
            }
            else
            {
                ErrorMessage = "Error al registrar. El usuario o email ya pueden estar en uso.";
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Error al registrarse: {ex.Message}";
        }
        finally
        {
            IsSubmitting = false;
        }
    }
}