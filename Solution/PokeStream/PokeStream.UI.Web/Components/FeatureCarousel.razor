@inject IJSRuntime JS
@using System.Text.Json
@using PokeStream.UI.Web.Components

<div class="feature-carousel" @ref="_carouselRef">
    <div class="feature-carousel__viewport" @ref="_viewportRef" @onmousedown="OnMouseDown" @ontouchstart="OnTouchStart" @onmouseleave="OnMouseUp" @onmouseup="OnMouseUp" @ontouchend="OnTouchEnd">
        <div class="feature-carousel__track" @ref="_trackRef" style="transform: translateX(@_translateX)px;">
            @foreach (var (feature, index) in _features.Select((f, i) => (f, i)))
            {
                <div class="feature-carousel__slide" style="width: @_slideWidth px; flex-shrink: 0;">
                    <FeatureCard Feature="feature" Index="index" IsActive="index == _currentIndex" />
                </div>
            }
        </div>
    </div>

    <!-- Navigation Buttons -->
    <button class="feature-carousel__nav feature-carousel__nav--prev"
            @onclick="GoToPrevious"
            @onclick:preventDefault="true"
            aria-label="Feature anterior"
            disabled="@_isAnimating">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
    </button>

    <button class="feature-carousel__nav feature-carousel__nav--next"
            @onclick="GoToNext"
            @onclick:preventDefault="true"
            aria-label="Siguiente feature"
            disabled="@_isAnimating">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
    </button>

    <!-- Indicators -->
    <div class="feature-carousel__indicators" role="tablist" aria-label="Navegación de features">
        @for (int i = 0; i < _features.Count; i++)
        {
            <button class="feature-carousel__indicator @(i == _currentIndex ? "active" : "")"
                    @onclick="() => GoToSlide(i)"
                    @onclick:preventDefault="true"
                    role="tab"
                    aria-selected="@(i == _currentIndex)"
                    aria-label="@($"Feature {i + 1}: {_features[i].Title}")">
                <span class="feature-carousel__indicator-dot"></span>
            </button>
        }
    </div>
</div>

@code {
    private ElementReference _carouselRef;
    private ElementReference _viewportRef;
    private ElementReference _trackRef;

    private readonly List<FeatureItem> _features = new()
    {
        new FeatureItem
        {
            Icon = "live-tv",
            Title = "Captura en Vivo",
            Description = "Los streamers muestran Pokémon en su overlay; los viewers capturan con comandos de chat como !catch",
            Gradient = "linear-gradient(135deg, rgba(255,140,0,0.15) 0%, rgba(13,27,42,0.1) 100%)",
            IconColor = "var(--color-primary)"
        },
        new FeatureItem
        {
            Icon = "collections",
            Title = "Tu Pokédex Persistente",
            Description = "Colección multiplataforma (Twitch, YouTube, Kick) con historial completo y sincronización automática",
            Gradient = "linear-gradient(135deg, rgba(13,27,42,0.15) 0%, rgba(255,140,0,0.1) 100%)",
            IconColor = "var(--color-secondary)"
        },
        new FeatureItem
        {
            Icon = "swap",
            Title = "Intercambios y Ranking",
            Description = "Intercambia Pokémon con otros viewers, completa tu Pokédex y sube en el ranking global",
            Gradient = "linear-gradient(135deg, rgba(255,140,0,0.1) 0%, rgba(13,27,42,0.15) 100%)",
            IconColor = "var(--color-tertiary)"
        },
        new FeatureItem
        {
            Icon = "auto-awesome",
            Title = "Verificación Automática",
            Description = "Sistema de códigos y cooldowns que valida capturas sin intervención manual del streamer",
            Gradient = "linear-gradient(135deg, rgba(13,27,42,0.1) 0%, rgba(255,140,0,0.15) 100%)",
            IconColor = "var(--color-info)"
        },
        new FeatureItem
        {
            Icon = "devices",
            Title = "Overlay MAUI",
            Description = "Aplicación de escritorio always-on-top transparente para OBS/Streamlabs en Windows y macOS",
            Gradient = "linear-gradient(135deg, rgba(255,140,0,0.15) 0%, rgba(13,27,42,0.1) 100%)",
            IconColor = "var(--color-warning)"
        },
        new FeatureItem
        {
            Icon = "web",
            Title = "PWA para Viewers",
            Description = "App web instalable, offline-capable, con notificaciones push para nunca perder un spawn",
            Gradient = "linear-gradient(135deg, rgba(13,27,42,0.1) 0%, rgba(255,140,0,0.15) 100%)",
            IconColor = "var(--color-tertiary)"
        }
    };

    private int _currentIndex = 0;
    private double _translateX = 0;
    private double _slideWidth = 0;
    private int _slidesPerView = 1;
    private bool _isAnimating = false;
    private bool _isDragging = false;
    private double _dragStartX = 0;
    private double _dragStartTranslateX = 0;
    private System.Timers.Timer? _autoPlayTimer;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await CalculateDimensions();
            StartAutoPlay();
        }
    }

    private async Task CalculateDimensions()
    {
        try
        {
            var viewportRect = await JS.InvokeAsync<JsonElement>("getBoundingClientRect", _viewportRef);
            var width = viewportRect.GetProperty("width").GetDouble();
            _slideWidth = width / _slidesPerView;

            // Calculate slides per view based on viewport width
            if (width >= 1024) _slidesPerView = 3;
            else if (width >= 768) _slidesPerView = 2;
            else _slidesPerView = 1;

            _slideWidth = width / _slidesPerView;
            UpdateTransform();
            StateHasChanged();
        }
        catch { }
    }

    private void UpdateTransform()
    {
        _translateX = -_currentIndex * _slideWidth;
    }

    private void GoToNext()
    {
        if (_isAnimating) return;
        _currentIndex = (_currentIndex + 1) % _features.Count;
        AnimateToCurrent();
    }

    private void GoToPrevious()
    {
        if (_isAnimating) return;
        _currentIndex = (_currentIndex - 1 + _features.Count) % _features.Count;
        AnimateToCurrent();
    }

    private void GoToSlide(int index)
    {
        if (_isAnimating || index == _currentIndex) return;
        _currentIndex = index;
        AnimateToCurrent();
    }

    private async void AnimateToCurrent()
    {
        _isAnimating = true;
        UpdateTransform();
        StateHasChanged();

        // Wait for CSS transition to complete
        await Task.Delay(300);
        _isAnimating = false;
        StateHasChanged();
    }

    private void OnMouseDown(MouseEventArgs e)
    {
        if (_isAnimating) return;
        _isDragging = true;
        _dragStartX = e.ClientX;
        _dragStartTranslateX = _translateX;
        StopAutoPlay();
    }

    private void OnTouchStart(TouchEventArgs e)
    {
        if (_isAnimating) return;
        _isDragging = true;
        _dragStartX = e.Touches[0].ClientX;
        _dragStartTranslateX = _translateX;
        StopAutoPlay();
    }

    private void OnMouseUp(MouseEventArgs e)
    {
        if (!_isDragging) return;
        _isDragging = false;
        HandleDragEnd(e.ClientX);
        StartAutoPlay();
    }

    private void OnTouchEnd(TouchEventArgs e)
    {
        if (!_isDragging) return;
        _isDragging = false;
        HandleDragEnd(e.ChangedTouches[0].ClientX);
        StartAutoPlay();
    }

    private void HandleDragEnd(double clientX)
    {
        var deltaX = clientX - _dragStartX;
        var threshold = _slideWidth * 0.25;

        if (Math.Abs(deltaX) > threshold)
        {
            if (deltaX > 0)
                _currentIndex = (_currentIndex - 1 + _features.Count) % _features.Count;
            else
                _currentIndex = (_currentIndex + 1) % _features.Count;
        }

        AnimateToCurrent();
    }

    private void StartAutoPlay()
    {
        StopAutoPlay();
        _autoPlayTimer = new System.Timers.Timer(5000);
        _autoPlayTimer.Elapsed += (s, e) => InvokeAsync(GoToNext);
        _autoPlayTimer.AutoReset = true;
        _autoPlayTimer.Start();
    }

    private void StopAutoPlay()
    {
        _autoPlayTimer?.Stop();
        _autoPlayTimer?.Dispose();
        _autoPlayTimer = null;
    }

    public void Dispose()
    {
        StopAutoPlay();
    }

    }