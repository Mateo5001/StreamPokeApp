@inherits LayoutComponentBase
@inject NavigationManager Navigation
@inject IJSRuntime JS
@using Microsoft.AspNetCore.Components.Authorization
@using MudBlazor

<MudLayout>
    <MudAppBar Elevation="1" Color="Color.Surface" Class="pokestream-appbar">
        <AuthorizeView>
            <Authorized>
                <MudButton Variant="Variant.Text" Color="Color.Inherit" OnClick="@ToggleDrawer" Class="menu-toggle-button" AriaLabel="Abrir menú de navegación" Type="ButtonType.Button">
                    <AppIcon Name="menu" Size="24" Style="color: var(--color-on-surface) !important;" />
                </MudButton>
            </Authorized>
        </AuthorizeView>
        <MudSpacer />
        <MudText Typo="Typo.h6" Class="pokestream-brand">PokéStream Collector</MudText>
        <MudSpacer />
        <MudButton Variant="Variant.Text" Color="Color.Inherit" OnClick="@ToggleTheme" Class="theme-toggle-button" AriaLabel="@(_isDarkMode ? "Cambiar a modo claro" : "Cambiar a modo oscuro")" Type="ButtonType.Button">
            <AppIcon Name="@(_isDarkMode ? "sun" : "moon")" Size="24" Style="color: var(--color-on-surface) !important;" />
        </MudButton>
        <LoginDisplay />
    </MudAppBar>

    <AuthorizeView>
        <Authorized>
            <MudDrawer @bind-Open="@_drawerOpen" Variant="DrawerVariant.Mini" ClipMode="DrawerClipMode.Always" Elevation="2" Class="pokestream-drawer">
                <NavMenu />
            </MudDrawer>
        </Authorized>
        <NotAuthorized>
            <!-- Empty space when not authenticated - no drawer -->
        </NotAuthorized>
    </AuthorizeView>

    <MudMainContent Class="mt-12 pa-4">
        @Body
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;
    private bool _isDarkMode = true; // Default to dark mode for PokéStream

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    private async Task ToggleTheme()
    {
        _isDarkMode = !_isDarkMode;
        await JS.InvokeVoidAsync("mudTheme.setDarkMode", _isDarkMode);
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _isDarkMode = await JS.InvokeAsync<bool>("mudTheme.getDarkMode");
            StateHasChanged();
        }
    }
}