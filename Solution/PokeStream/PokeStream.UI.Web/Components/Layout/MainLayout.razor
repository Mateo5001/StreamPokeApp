@using Microsoft.AspNetCore.Components.Authorization
@using PokeStream.Core.Services.Themes
@using PokeStream.UI.Web.Components.Pages
@inherits LayoutComponentBase

<MudThemeProvider Theme="_theme" @bind-IsDarkMode="_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <AuthorizeView>
            <Authorized>
                <MudIconButton Icon="@logoIcon" Style="font-size: 48px;" Color="Color.Inherit" OnClick="ToggleDrawer">Menu</MudIconButton>
            </Authorized>
            <NotAuthorized>
                <MudIcon Icon="@logoIcon" Style="font-size: 48px;" />
            </NotAuthorized>
        </AuthorizeView>
        <MudLink Href="/">
            <MudImage Src="@logoName" Alt="PokéStream" Width="220" />
        </MudLink>
        <MudSpacer/>
        <MudToggleIconButton @bind-Toggled="_isDarkMode"
                             Icon="@AppIcon.DarkMode"
                             ToggledIcon="@AppIcon.LightMode"
                             Color="Color.Inherit"
                             title="Cambiar tema" />
    </MudAppBar>
    <MudMainContent>
        <AuthorizeView>
            <Authorized>
                <MudDrawer @bind-Open="_drawerOpen" Elevation="2">
                    <NavMenu />
                </MudDrawer>
                <MudContainer MaxWidth="MaxWidth.Large" Class="my-6">
                    @Body
                </MudContainer>
            </Authorized>
            <NotAuthorized>
                <MudContainer MaxWidth="MaxWidth.Large" Class="my-6">
                    <Home></Home>
                </MudContainer>
            </NotAuthorized>
        </AuthorizeView>
        
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private readonly MudTheme _theme = new PokeStreamTheme();
    private bool _isDarkMode;
    private bool _drawerOpen = false;
    
    private string logoIcon => _isDarkMode ? AppIcon.LogoBlue : AppIcon.LogoOrange;
    private string logoName => _isDarkMode ? AppIcon.Images.WordmarkOnBlue : AppIcon.Images.WordmarkOnOrange;

    private void ToggleDrawer() { _drawerOpen = !_drawerOpen; }
}
