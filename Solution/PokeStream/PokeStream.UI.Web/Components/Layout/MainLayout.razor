@inherits LayoutComponentBase
@inject NavigationManager Navigation
@inject IJSRuntime JS
@using Microsoft.AspNetCore.Components.Authorization
@using MudBlazor

<MudLayout>
    <PokestreamThemeProvider />
    <MudAppBar Elevation="1" Color="Color.Surface" Class="pokestream-appbar">
        <MudLink Href="/" Class="d-flex align-items-center gap-2 text-decoration-none" Style="color: var(--color-on-surface);">
            <AppIcon Name="brand-pokestream" Size="28" />
            <MudText Typo="Typo.h6" Class="pokestream-brand">PokéStream Collector</MudText>
        </MudLink>
        <MudSpacer />
        <ThemeToggle />
        <LoginDisplay />
    </MudAppBar>

    <AuthorizeView>
        <Authorized>
            <MudDrawer @bind-Open="@_drawerOpen" Variant="DrawerVariant.Mini" ClipMode="DrawerClipMode.Always" Elevation="2" Class="pokestream-drawer">
                <NavMenu />
            </MudDrawer>
        </Authorized>
        <NotAuthorized>
            <!-- Empty space when not authenticated - no drawer -->
        </NotAuthorized>
    </AuthorizeView>

    <MudMainContent Class="mt-12 pa-4">
        @Body
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;
}