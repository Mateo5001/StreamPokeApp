@using PokeStream.UI.Web.Theme
@inject PokestreamThemeProvider ThemeProvider
@inject IJSRuntime JS
@implements IDisposable

<button class="theme-toggle" @onclick="OnClick" @onclick:preventDefault="true" type="button" @onkeydown="OnKeyDown" aria-label="@AriaLabel" aria-pressed="@_isDark">
    <div class="theme-toggle__track" style="background: @TrackBackground;">
        <div class="theme-toggle__thumb" style="
            transform: translateX(@ThumbTranslate);
            background: @ThumbBackground;
            box-shadow: @ThumbShadow;
        ">
            <svg class="theme-toggle__icon theme-toggle__icon--sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="opacity: @SunOpacity; transform: rotate(@SunRotation) scale(@SunScale);">
                <circle cx="12" cy="12" r="5"></circle>
                <line x1="12" y1="1" x2="12" y2="3"></line>
                <line x1="12" y1="21" x2="12" y2="23"></line>
                <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
                <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
                <line x1="1" y1="12" x2="3" y2="12"></line>
                <line x1="21" y1="12" x2="23" y2="12"></line>
                <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
                <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
            </svg>
            <svg class="theme-toggle__icon theme-toggle__icon--moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="opacity: @MoonOpacity; transform: rotate(@MoonRotation) scale(@MoonScale);">
                <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
            </svg>
        </div>
    </div>
    <span class="theme-toggle__label" style="opacity: @LabelOpacity;">@LabelText</span>
</button>

@code {
    private bool _isDark = true;

    protected override void OnInitialized()
    {
        ThemeProvider.OnThemeChanged += OnThemeChanged;
        _isDark = ThemeProvider.IsDark;
    }

    [JSInvokable]
    public async Task OnJsToggle()
    {
        var newIsDark = !_isDark;
        await JS.InvokeVoidAsync("pokestreamTheme.setIsDark", newIsDark);
    }

    private async Task OnClick()
    {
        await OnJsToggle();
    }

    private void OnThemeChanged()
    {
        _isDark = ThemeProvider.IsDark;
        StateHasChanged();
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" || e.Key == " ")
        {
            await OnJsToggle();
        }
    }

    private string TrackBackground => _isDark
        ? "var(--gradient-secondary)"
        : "linear-gradient(135deg, #E2E8F0 0%, #CBD5E1 100%)";

    private string ThumbTranslate => _isDark ? "28px" : "2px";

    private string ThumbBackground => _isDark
        ? "var(--gradient-primary)"
        : "linear-gradient(135deg, #E86C00 0%, #CC5800 100%)";

    private string ThumbShadow => _isDark
        ? "0 2px 8px rgba(255,140,0,0.4), 0 0 16px rgba(255,140,0,0.3)"
        : "0 2px 8px rgba(232,108,0,0.3), 0 0 12px rgba(232,108,0,0.2)";

    private double SunOpacity => _isDark ? 0 : 1;
    private double SunRotation => _isDark ? -90 : 0;
    private double SunScale => _isDark ? 0.5 : 1;

    private double MoonOpacity => _isDark ? 1 : 0;
    private double MoonRotation => _isDark ? 0 : 90;
    private double MoonScale => _isDark ? 1 : 0.5;

    private double LabelOpacity => _isDark ? 1 : 1;

    private string AriaLabel => _isDark ? "Cambiar a modo día" : "Cambiar a modo noche";
    private string LabelText => _isDark ? "Noche" : "Día";

    public void Dispose()
    {
        ThemeProvider.OnThemeChanged -= OnThemeChanged;
    }
}