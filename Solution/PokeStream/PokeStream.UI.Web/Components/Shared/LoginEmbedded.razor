@using PokeStream.Core.DTOs.Auth
@using PokeStream.Core.Services.AuthServices
@using PokeStream.Core.Services.Cookies
@using PokeStream.Resources.Auth
@using PokeStream.Resources.Common
@inject AuthStateService Auth
@inject ICookieService Cookies

<MudStack Spacing="3" Class="pa-4" Style="width: 300px; max-width: 100%;">

    <MudText Typo="Typo.h6" Align="Align.Center">@LoginResource.Title</MudText>

    <MudForm @ref="_form" Model="@_request">
        <EditForm Model="@_request">
            <DataAnnotationsValidator />
            <MudStack Spacing="1">
                <MudTextField @bind-Value="_request.UsernameOrEmail"
                              For="@(() => _request.UsernameOrEmail)"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              AutoFocus="true" />

                <MudTextField @bind-Value="_request.Password"
                              For="@(() => _request.Password)" 
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              InputType="@(_showPassword ? InputType.Text : InputType.Password)"
                              Adornment="Adornment.End"
                              AdornmentIcon="@(_showPassword ? AppIcon.VisibilityOff : AppIcon.Visibility)"
                              OnAdornmentClick="() => _showPassword = !_showPassword"
                              AdornmentAriaLabel="@LoginResource.ShowHidePassword" />

                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                    <MudCheckBox @bind-Value="_remember" Label="@LoginResource.RememberMe" Dense="true" Color="Color.Primary" />
                    <MudLink Href="/forgot-password" Typo="Typo.caption">@LoginResource.ForgotPassword</MudLink>
                </MudStack>
            </MudStack>
        </EditForm>
    </MudForm>

    @if (_error is not null)
    {
        <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
    }

    <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
               Disabled="_busy" OnClick="LoginAsync">
        @LoginResource.SubmitButton
    </MudButton>

    <MudDivider />
    <MudText Typo="Typo.caption" Align="Align.Center" Color="Color.Default">@LoginResource.OrContinueWith</MudText>

    <MudStack Spacing="1">
        <MudButton Variant="Variant.Filled"
                   FullWidth="true"
                   StartIcon="@AppIcon.Twitch"
                   Style="background-color: #9146FF; color: #FFFFFF;">
            Twitch
        </MudButton>
        <MudButton Variant="Variant.Filled"
                   FullWidth="true"
                   StartIcon="@AppIcon.Kick"
                   Style="background-color: #53FC18; color: #000000;">
            Kick
        </MudButton>
        <MudButton Variant="Variant.Filled"
                   FullWidth="true"
                   StartIcon="@AppIcon.YouTube"
                   Style="background-color: #FF0000; color: #FFFFFF;">
            YouTube
        </MudButton>
    </MudStack>

    <MudText Typo="Typo.body2" Align="Align.Center">
        @LoginResource.NoAccount
        <MudLink Href="/register">@LoginResource.CreateAccount</MudLink>
    </MudText>

</MudStack>

@code {
    private MudForm? _form;
    private readonly LoginRequest _request = new();
    private bool _remember; // UI only: LoginRequest has no "remember me" field; persisted as a cookie instead

    private bool _showPassword;
    private bool _busy;
    private string? _error;

    private const int RememberedUserDays = 30;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        // Pre-fill the "Recordarme" username (JS cookies are only available after the first render)
        var user = await Cookies.GetAsync(CookieKeys.RememberedUser);
        if (string.IsNullOrEmpty(user)) return;

        _request.UsernameOrEmail = user;
        _remember = true;
        StateHasChanged();
    }

    private async Task LoginAsync()
    {
        if (_form is null) return;
        await _form.ValidateAsync();
        if (!_form.IsValid) return;

        _busy = true;
        _error = null;
        try
        {
            var response = await Auth.LoginAsync(_request);
            if (response is null)
            {
                _error = LoginResource.InvalidCredentials;
                return;
            }

            if (_remember)
                await Cookies.SetAsync(CookieKeys.RememberedUser, _request.UsernameOrEmail, RememberedUserDays);
            else
                await Cookies.RemoveAsync(CookieKeys.RememberedUser);

            _request.Password = string.Empty;
        }
        catch (HttpRequestException)
        {
            _error = CommonResource.ServerUnreachable;
        }
        finally
        {
            _busy = false;
        }
    }
}
