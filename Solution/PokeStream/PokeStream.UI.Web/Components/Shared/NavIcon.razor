@* NavIcon.razor - Custom SVG icons for navigation *@
@* Uses SVG files from wwwroot/icons (copied from docs/assets/icons) *@

<img class="nav-icon @Class"
     src="@IconPath"
     alt=""
     width="24"
     height="24"
     aria-hidden="true" />

@code {
    // Icon name: home, collection, trade, leaderboard, profile, settings
    [Parameter] public string Name { get; set; } = "home";

    // Additional CSS classes
    [Parameter] public string Class { get; set; } = "";

    private string IconPath => $"/icons/nav-{Name}.svg";
}