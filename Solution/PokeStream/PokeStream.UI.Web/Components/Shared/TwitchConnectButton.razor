@using System.Net.Http.Json
@using System.Text.Json
@using PokeStream.Core.DTOs.Common
@using PokeStream.Core.DTOs.Twitch
@using PokeStream.Core.Services.AuthServices
@using PokeStream.Resources.Common
@using PokeStream.Resources.Creator
@inject AuthStateService Auth
@inject NavigationManager Navigation

@* Sends the signed-in user to Twitch; they come back to /twitch/callback *@
<MudStack Spacing="2">
    @if (_error is not null)
    {
        <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
    }
    <MudButton Variant="Variant.Filled" StartIcon="@AppIcon.Twitch" OnClick="ConnectAsync" Disabled="_busy"
               Style="background-color: #9146FF; color: #FFFFFF; align-self: flex-start;">
        @CreatorResource.TwitchConnect
    </MudButton>
</MudStack>

@code {
    private bool _busy;
    private string? _error;

    private async Task ConnectAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            // Fresh access token before leaving, so it is still valid when Twitch sends the user back
            if (!await Auth.RefreshTokenAsync())
            {
                _error = CreatorResource.TwitchFailed;
                return;
            }

            var response = await Auth.SendAuthorizedAsync(HttpMethod.Post, "api/v1/twitch/connect");
            if (!response.IsSuccessStatusCode)
            {
                _error = await ReadErrorAsync(response);
                return;
            }

            var connect = await response.Content.ReadFromJsonAsync<TwitchConnectResponse>();
            Navigation.NavigateTo(connect!.Url, forceLoad: true);
        }
        catch (HttpRequestException) { _error = CommonResource.ServerUnreachable; }
        finally { _busy = false; }
    }

    public static async Task<string> ReadErrorAsync(HttpResponseMessage response)
    {
        // 401/403 come with an empty body
        try { return (await response.Content.ReadFromJsonAsync<ErrorResponse>())?.Message ?? CreatorResource.TwitchFailed; }
        catch (JsonException) { return CreatorResource.TwitchFailed; }
    }
}
