@* AppIcon.razor - Reusable app icons from wwwroot/icons *@

<img class="app-icon @Class"
     src="@IconPath"
     alt=""
     width="@Size"
     height="@Size"
     aria-hidden="true"
     style="@Style" />

@code {
    /// <summary>
    /// Icon name without extension (e.g., "nav-home", "pokemon", "pokeball")
    /// </summary>
    [Parameter] public string Name { get; set; } = "nav-home";

    /// <summary>
    /// Additional CSS classes
    /// </summary>
    [Parameter] public string Class { get; set; } = "";

    /// <summary>
    /// Icon size in pixels
    /// </summary>
    [Parameter] public int Size { get; set; } = 24;

    /// <summary>
    /// Inline styles
    /// </summary>
    [Parameter] public string Style { get; set; } = "";

    private string IconPath => $"/icons/{Name}.svg";
}